# Alembic config for {{ service_name }}.
# The database URL is injected at runtime from APP_DB_POSTGRES_DSN by env.py;
# it is intentionally not written here so no DSN is committed.
# Run migrations from the project root, e.g.:
#   uv run alembic -c migrations/alembic.ini revision --autogenerate -m "message"
#   uv run alembic -c migrations/alembic.ini upgrade head

[alembic]
script_location = migrations
prepend_sys_path = .
path_separator = os
sqlalchemy.url =

[post_write_hooks]
hooks = ruff
ruff.type = exec
ruff.executable = ruff
ruff.options = format REVISION_SCRIPT_FILENAME
