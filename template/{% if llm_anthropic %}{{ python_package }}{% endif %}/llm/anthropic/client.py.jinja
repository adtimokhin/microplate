"""Process-wide async Anthropic client, bound to the FastAPI lifespan.

One :class:`~anthropic.AsyncAnthropic` per process. The SDK's own retries are
turned off (``max_retries=0``); ``tenacity`` owns retry/backoff around the
sample call. Construction performs no I/O.
"""

from __future__ import annotations

from anthropic import AsyncAnthropic

from {{ python_package }}.config import get_settings

_client: AsyncAnthropic | None = None


def init_client() -> AsyncAnthropic:
    """Build the client from settings. Idempotent within a process."""

    global _client

    settings = get_settings()
    _client = AsyncAnthropic(
        api_key=settings.llm_anthropic_api_key,
        base_url=settings.llm_anthropic_base_url or None,
        timeout=float(settings.llm_anthropic_timeout_s),
        max_retries=0,
    )
    return _client


def get_client() -> AsyncAnthropic:
    """Return the process-wide client, or raise if the lifespan has not run."""

    if _client is None:
        raise RuntimeError(
            "Anthropic client is not initialised; is the application lifespan running?"
        )
    return _client


async def close_client() -> None:
    """Close the client and clear the holder."""

    global _client

    if _client is not None:
        await _client.close()
    _client = None
