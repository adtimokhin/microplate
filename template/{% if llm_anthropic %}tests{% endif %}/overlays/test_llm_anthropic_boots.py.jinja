"""Proves the llm_anthropic overlay is wired into the running app (overlay-contract 7).

Runs offline: an httpx2 ``MockTransport`` (or a local stub server when
``llm_response_mode == 'fake_server'``) returns a canned Messages response, so
the sample summarize call and the readiness check exercise the real wiring with
no network and no real API key.
"""

from __future__ import annotations

from anthropic import AsyncAnthropic


async def test_llm_anthropic_boots(anthropic_client: object) -> None:
    from {{ python_package }}.health import check_llm_anthropic
    from {{ python_package }}.lifespan import lifespan
    from {{ python_package }}.llm.anthropic.client import get_client
    from {{ python_package }}.main import app

    async with lifespan(app):
        client = getattr(app.state, "llm_anthropic", None)
        assert client is not None, "llm_anthropic client missing from app.state"
        assert isinstance(client, AsyncAnthropic)
        assert client is get_client()

        result = await check_llm_anthropic()
        assert result.healthy, result


def test_llm_anthropic_summarize_route(anthropic_client: object, client) -> None:
    response = client.post("/llm/anthropic/summarize", json={"text": "a longer piece of text"})
    assert response.status_code == 200
    body = response.json()
    assert isinstance(body["summary"], str)
    assert body["summary"]


def test_llm_anthropic_summarize_operation_in_openapi(anthropic_client: object, client) -> None:
    schema = client.get("/openapi.json").json()
    op_ids = {
        methods[verb]["operationId"]
        for methods in schema["paths"].values()
        for verb in methods
        if "operationId" in methods[verb]
    }
    assert "llm_anthropic_summarize" in op_ids
