{#- Generated by the claude_hooks overlay (D-041). Wires only the hooks whose
    hook_* answer is true. Edit hook selection via `copier update`, not by hand.
    Commands run from the project root; $CLAUDE_PROJECT_DIR is set by Claude Code. -#}
{%- set CMD = 'node "$CLAUDE_PROJECT_DIR/.claude/hooks/' -%}
{%- set ns = namespace(pre=[], post=[], sstart=[], send=[], iload=[], ups=[]) -%}
{%- if hook_guard_pack | default(false) -%}
{%- set ns.pre = ns.pre + [{"matcher": "Bash|Read|Edit|MultiEdit|Write", "hooks": [{"type": "command", "command": CMD ~ 'guard-pack.js"'}]}] -%}
{%- endif -%}
{%- if hook_protect_tests | default(false) -%}
{%- set ns.pre = ns.pre + [{"matcher": "Bash|Edit|MultiEdit|Write", "hooks": [{"type": "command", "command": CMD ~ 'protect-tests.js"'}]}] -%}
{%- endif -%}
{%- if hook_instructions_audit | default(false) -%}
{%- set ns.pre = ns.pre + [{"hooks": [{"type": "command", "command": CMD ~ 'instructions-audit.js"'}]}] -%}
{%- set ns.iload = ns.iload + [{"hooks": [{"type": "command", "command": CMD ~ 'instructions-audit.js"'}]}] -%}
{%- set ns.ups = ns.ups + [{"hooks": [{"type": "command", "command": CMD ~ 'instructions-audit.js"'}]}] -%}
{%- endif -%}
{%- if hook_format_code | default(false) -%}
{%- set ns.post = ns.post + [{"matcher": "Write|Edit", "hooks": [{"type": "command", "command": CMD ~ 'format-code.js"'}]}] -%}
{%- endif -%}
{%- if hook_auto_stage | default(false) -%}
{%- set ns.post = ns.post + [{"matcher": "Edit|Write", "hooks": [{"type": "command", "command": CMD ~ 'auto-stage.js"'}]}] -%}
{%- endif -%}
{%- if hook_session_logger | default(false) -%}
{%- set ns.sstart = ns.sstart + [{"hooks": [{"type": "command", "command": CMD ~ 'session-logger.js"'}]}] -%}
{%- set ns.post = ns.post + [{"matcher": "Edit|Write|Bash|Read", "hooks": [{"type": "command", "async": true, "command": CMD ~ 'session-logger.js"'}]}] -%}
{%- set ns.send = ns.send + [{"hooks": [{"type": "command", "command": CMD ~ 'session-logger.js"'}]}] -%}
{%- endif -%}
{%- set ns.events = {} -%}
{%- if ns.iload -%}{%- set ns.events = dict(ns.events, InstructionsLoaded=ns.iload) -%}{%- endif -%}
{%- if ns.ups -%}{%- set ns.events = dict(ns.events, UserPromptSubmit=ns.ups) -%}{%- endif -%}
{%- if ns.sstart -%}{%- set ns.events = dict(ns.events, SessionStart=ns.sstart) -%}{%- endif -%}
{%- if ns.pre -%}{%- set ns.events = dict(ns.events, PreToolUse=ns.pre) -%}{%- endif -%}
{%- if ns.post -%}{%- set ns.events = dict(ns.events, PostToolUse=ns.post) -%}{%- endif -%}
{%- if ns.send -%}{%- set ns.events = dict(ns.events, SessionEnd=ns.send) -%}{%- endif -%}
{{ {"hooks": ns.events} | tojson(indent=2) }}
