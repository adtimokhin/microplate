"""Proves the MCP server is wired: it builds and registers the service's tools
in-process (D-035). No transport, no network - the tested contract.

The ``/mcp`` streamable-http mount and the lifespan chaining that makes it
actually serve requests are exercised end to end in
``test_mcp_server_http.py`` (Phase 7 hardening)."""

from __future__ import annotations


def test_mcp_server_builds() -> None:
    from {{ python_package }}.mcp.server import get_server

    assert get_server() is not None


def test_mcp_server_registers_tools() -> None:
    from {{ python_package }}.mcp.server import list_tool_names

    names = list_tool_names()
    assert names, "no MCP tools registered - check the pinned mcp SDK registration surface"
