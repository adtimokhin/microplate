def test_mcp_app_imports_without_error() -> None:
    """The api_router fragment appends the /mcp mount at import time; this
    confirms that path does not raise (it degrades to a placeholder if the SDK
    HTTP surface is unavailable)."""
    from {{ python_package }}.mcp.server import get_asgi_app

    assert get_asgi_app() is not None
