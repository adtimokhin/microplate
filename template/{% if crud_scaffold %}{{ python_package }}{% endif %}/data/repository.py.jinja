class Redis{{ crud_entity | capitalize }}Repository:
    """One Redis hash per {{ crud_entity }} at ``{{ crud_entity }}:<id>``, plus a sorted set
    ``{{ crud_entity }}:index`` (score = created_at) for ordered listing. Filtering by
    name has no secondary index, so it scans and filters client-side."""

    _INDEX = "{{ crud_entity }}:index"

    def __init__(self) -> None:
        from {{ python_package }}.db.redis import get_client

        self._r = get_client()

    def _key(self, entity_id: str) -> str:
        return f"{{ crud_entity }}:{entity_id}"

    def _to_entity(self, entity_id: str, h: Mapping[Any, Any]) -> Entity:
        from datetime import datetime as _dt

        d = {str(k): str(v) for k, v in h.items()}
        return Entity(
            id=entity_id,
            name=d["name"],
            description=d.get("description", ""),
            created_at=_dt.fromisoformat(d["created_at"]),
        )

    async def create(self, data: {{ crud_entity | capitalize }}Create) -> Entity:
        entity_id = str(uuid.uuid4())
        created = _now()
        mapping: dict[str, str] = {
            "name": data.name,
            "description": data.description,
            "created_at": created.isoformat(),
{% if crud_soft_delete %}            "deleted_at": "",
{% endif %}        }
        await self._r.hset(self._key(entity_id), mapping=mapping)  # type: ignore[arg-type]
        await self._r.zadd(self._INDEX, {entity_id: created.timestamp()})
        return Entity(id=entity_id, created_at=created, **data.model_dump())

    async def bulk_create(self, items: list[{{ crud_entity | capitalize }}Create]) -> list[Entity]:
        created = _now()
        entries = [(str(uuid.uuid4()), data) for data in items]
        pipe = self._r.pipeline()
        for entity_id, data in entries:
            mapping: dict[str, str] = {
                "name": data.name,
                "description": data.description,
                "created_at": created.isoformat(),
{% if crud_soft_delete %}                "deleted_at": "",
{% endif %}            }
            pipe.hset(self._key(entity_id), mapping=mapping)  # type: ignore[arg-type]
            pipe.zadd(self._INDEX, {entity_id: created.timestamp()})
        if entries:
            await pipe.execute()
        return [Entity(id=eid, created_at=created, **data.model_dump()) for eid, data in entries]

    async def get(self, entity_id: str) -> Entity | None:
        h = await self._r.hgetall(self._key(entity_id))
        if not h:
            return None
{% if crud_soft_delete %}        if h.get("deleted_at"):
            return None
{% endif %}        return self._to_entity(entity_id, h)

    async def list(
        self, *, limit: int = 50, offset: int = 0, name_contains: str | None = None
    ) -> list[Entity]:
        if name_contains:
            ids = await self._r.zrange(self._INDEX, 0, -1)
            needle = name_contains.lower()
            matched: list[Entity] = []
            for raw_id in ids:
                row = await self.get(str(raw_id))
                if row is not None and needle in row.name.lower():
                    matched.append(row)
            return matched[offset : offset + limit]
        ids = await self._r.zrange(self._INDEX, offset, offset + limit - 1)
        out: list[Entity] = []
        for raw_id in ids:
            row = await self.get(str(raw_id))
            if row is not None:
                out.append(row)
        return out

    async def update(self, entity_id: str, data: {{ crud_entity | capitalize }}Update) -> Entity | None:
        if not await self.exists(entity_id):
            return None
        patch: dict[str, str] = {k: str(v) for k, v in data.model_dump(exclude_none=True).items()}
        if patch:
            await self._r.hset(self._key(entity_id), mapping=patch)  # type: ignore[arg-type]
        return await self.get(entity_id)

    async def delete(self, entity_id: str) -> bool:
{% if crud_soft_delete %}        if not await self.exists(entity_id):
            return False
        await self._r.hset(self._key(entity_id), "deleted_at", _now().isoformat())  # type: ignore[arg-type]
        await self._r.zrem(self._INDEX, entity_id)
        return True
{% else %}        removed = await self._r.delete(self._key(entity_id))
        await self._r.zrem(self._INDEX, entity_id)
        return removed == 1
{% endif %}
    async def bulk_delete(self, entity_ids: Sequence[str]) -> int:
        deleted = 0
        for eid in entity_ids:
            if await self.delete(eid):
                deleted += 1
        return deleted

    async def count(self, *, name_contains: str | None = None) -> int:
        if name_contains:
            return len(await self.list(limit=1_000_000, offset=0, name_contains=name_contains))
        return int(await self._r.zcard(self._INDEX))

    async def exists(self, entity_id: str) -> bool:
{% if crud_soft_delete %}        return await self.get(entity_id) is not None
{% else %}        return bool(await self._r.exists(self._key(entity_id)))
{% endif %}

def get_repository() -> {{ crud_entity | capitalize }}Repository:
    return Redis{{ crud_entity | capitalize }}Repository()
