        return get_session_factory()()

    async def create(self, data: {{ crud_entity | capitalize }}Create) -> Entity:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        row = {{ crud_entity | capitalize }}Row(id=str(uuid.uuid4()), created_at=_now(), **data.model_dump())
        async with self._session() as s:
            s.add(row)
            await s.commit()
            return Entity.model_validate(row, from_attributes=True)

    async def bulk_create(self, items: list[{{ crud_entity | capitalize }}Create]) -> list[Entity]:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        rows = [
            {{ crud_entity | capitalize }}Row(id=str(uuid.uuid4()), created_at=_now(), **item.model_dump()) for item in items
        ]
        async with self._session() as s:
            s.add_all(rows)
            await s.commit()
            return [Entity.model_validate(r, from_attributes=True) for r in rows]

    async def get(self, entity_id: str) -> Entity | None:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        async with self._session() as s:
            row = await s.get({{ crud_entity | capitalize }}Row, entity_id)
{% if crud_soft_delete %}            if row is not None and row.deleted_at is not None:
                return None
{% endif %}            return Entity.model_validate(row, from_attributes=True) if row else None

    async def list(
        self, *, limit: int = 50, offset: int = 0, name_contains: str | None = None
    ) -> list[Entity]:
        from sqlalchemy import select

        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        stmt = select({{ crud_entity | capitalize }}Row).order_by({{ crud_entity | capitalize }}Row.created_at)
{% if crud_soft_delete %}        stmt = stmt.where({{ crud_entity | capitalize }}Row.deleted_at.is_(None))
{% endif %}        if name_contains:
            stmt = stmt.where({{ crud_entity | capitalize }}Row.name.ilike(f"%{name_contains}%"))
        stmt = stmt.limit(limit).offset(offset)
        async with self._session() as s:
            rows = (await s.execute(stmt)).scalars().all()
        return [Entity.model_validate(r, from_attributes=True) for r in rows]

    async def update(self, entity_id: str, data: {{ crud_entity | capitalize }}Update) -> Entity | None:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        async with self._session() as s:
            row = await s.get({{ crud_entity | capitalize }}Row, entity_id)
            if row is None:
                return None
{% if crud_soft_delete %}            if row.deleted_at is not None:
                return None
{% endif %}            for field, value in data.model_dump(exclude_none=True).items():
                setattr(row, field, value)
            await s.commit()
            return Entity.model_validate(row, from_attributes=True)

    async def delete(self, entity_id: str) -> bool:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        async with self._session() as s:
            row = await s.get({{ crud_entity | capitalize }}Row, entity_id)
            if row is None:
                return False
{% if crud_soft_delete %}            if row.deleted_at is not None:
                return False
            row.deleted_at = _now()
            await s.commit()
            return True
{% else %}            await s.delete(row)
            await s.commit()
            return True
{% endif %}
    async def bulk_delete(self, entity_ids: Sequence[str]) -> int:
        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        if not entity_ids:
            return 0
{% if crud_soft_delete %}        from sqlalchemy import update as sa_update

        stmt = (
            sa_update({{ crud_entity | capitalize }}Row)
            .where(
                {{ crud_entity | capitalize }}Row.id.in_(entity_ids),
                {{ crud_entity | capitalize }}Row.deleted_at.is_(None),
            )
            .values(deleted_at=_now())
        )
{% else %}        from sqlalchemy import delete as sa_delete

        stmt = sa_delete({{ crud_entity | capitalize }}Row).where({{ crud_entity | capitalize }}Row.id.in_(entity_ids))
{% endif %}        async with self._session() as s:
            result = await s.execute(stmt)
            await s.commit()
            return result.rowcount or 0  # type: ignore[attr-defined]

    async def count(self, *, name_contains: str | None = None) -> int:
        from sqlalchemy import func, select

        from {{ python_package }}.data.models import {{ crud_entity | capitalize }}Row

        stmt = select(func.count()).select_from({{ crud_entity | capitalize }}Row)
{% if crud_soft_delete %}        stmt = stmt.where({{ crud_entity | capitalize }}Row.deleted_at.is_(None))
{% endif %}        if name_contains:
            stmt = stmt.where({{ crud_entity | capitalize }}Row.name.ilike(f"%{name_contains}%"))
        async with self._session() as s:
            return int((await s.execute(stmt)).scalar_one())

    async def exists(self, entity_id: str) -> bool:
        return await self.get(entity_id) is not None


