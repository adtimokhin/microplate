class InMemory{{ crud_entity | capitalize }}Repository:
    """In-process dict store. Used by the offline test fixture (D-039)."""

    def __init__(self) -> None:
        self._rows: dict[str, Entity] = {}
        self._deleted_at: dict[str, datetime] = {}

    async def create(self, data: {{ crud_entity | capitalize }}Create) -> Entity:
        row = Entity(id=str(uuid.uuid4()), created_at=_now(), **data.model_dump())
        self._rows[row.id] = row
        return row

    async def bulk_create(self, items: list[{{ crud_entity | capitalize }}Create]) -> list[Entity]:
        return [await self.create(item) for item in items]

    async def get(self, entity_id: str) -> Entity | None:
        if entity_id in self._deleted_at:
            return None
        return self._rows.get(entity_id)

    async def list(
        self, *, limit: int = 50, offset: int = 0, name_contains: str | None = None
    ) -> list[Entity]:
        rows = [r for r in self._rows.values() if r.id not in self._deleted_at]
        if name_contains:
            needle = name_contains.lower()
            rows = [r for r in rows if needle in r.name.lower()]
        rows.sort(key=lambda r: r.created_at)
        return rows[offset : offset + limit]

    async def update(self, entity_id: str, data: {{ crud_entity | capitalize }}Update) -> Entity | None:
        if entity_id in self._deleted_at:
            return None
        row = self._rows.get(entity_id)
        if row is None:
            return None
        updated = row.model_copy(update=data.model_dump(exclude_none=True))
        self._rows[entity_id] = updated
        return updated

    async def delete(self, entity_id: str) -> bool:
        if entity_id not in self._rows or entity_id in self._deleted_at:
            return False
{% if crud_soft_delete %}        self._deleted_at[entity_id] = _now()
{% else %}        del self._rows[entity_id]
{% endif %}        return True

    async def bulk_delete(self, entity_ids: Sequence[str]) -> int:
        # NOTE: a generator expression here (`sum(1 for x in xs if await ...)`)
        # would silently become an async generator and break `sum()`; loop instead.
        deleted = 0
        for eid in entity_ids:
            if await self.delete(eid):
                deleted += 1
        return deleted

    async def count(self, *, name_contains: str | None = None) -> int:
        rows = [r for r in self._rows.values() if r.id not in self._deleted_at]
        if name_contains:
            needle = name_contains.lower()
            rows = [r for r in rows if needle in r.name.lower()]
        return len(rows)

    async def exists(self, entity_id: str) -> bool:
        return entity_id in self._rows and entity_id not in self._deleted_at

