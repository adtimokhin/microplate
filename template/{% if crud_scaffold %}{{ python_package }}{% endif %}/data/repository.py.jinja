class Redis{{ crud_entity | capitalize }}Repository:
    """One Redis hash per {{ crud_entity }} at ``{{ crud_entity }}:<id>``, plus a sorted set
    ``{{ crud_entity }}:index`` (score = created_at) for ordered listing."""

    _INDEX = "{{ crud_entity }}:index"

    def __init__(self) -> None:
        from {{ python_package }}.db.redis import get_client

        self._r = get_client()

    def _key(self, entity_id: str) -> str:
        return f"{{ crud_entity }}:{entity_id}"

    def _to_entity(self, entity_id: str, h: Mapping[Any, Any]) -> Entity:
        from datetime import datetime

        d = {str(k): str(v) for k, v in h.items()}
        return Entity(
            id=entity_id,
            name=d["name"],
            description=d.get("description", ""),
            created_at=datetime.fromisoformat(d["created_at"]),
        )

    async def create(self, data: {{ crud_entity | capitalize }}Create) -> Entity:
        entity_id = str(uuid.uuid4())
        created = _now()
        mapping: dict[str, str] = {
            "name": data.name,
            "description": data.description,
            "created_at": created.isoformat(),
        }
        await self._r.hset(self._key(entity_id), mapping=mapping)  # type: ignore[arg-type]
        await self._r.zadd(self._INDEX, {entity_id: created.timestamp()})
        return Entity(id=entity_id, created_at=created, **data.model_dump())

    async def get(self, entity_id: str) -> Entity | None:
        h = await self._r.hgetall(self._key(entity_id))
        return self._to_entity(entity_id, h) if h else None

    async def list(self, *, limit: int = 50, offset: int = 0) -> list[Entity]:
        ids = await self._r.zrange(self._INDEX, offset, offset + limit - 1)
        out: list[Entity] = []
        for raw_id in ids:
            row = await self.get(str(raw_id))
            if row is not None:
                out.append(row)
        return out

    async def update(self, entity_id: str, data: {{ crud_entity | capitalize }}Update) -> Entity | None:
        if not await self.exists(entity_id):
            return None
        patch: dict[str, str] = {k: str(v) for k, v in data.model_dump(exclude_none=True).items()}
        if patch:
            await self._r.hset(self._key(entity_id), mapping=patch)  # type: ignore[arg-type]
        return await self.get(entity_id)

    async def delete(self, entity_id: str) -> bool:
        removed = await self._r.delete(self._key(entity_id))
        await self._r.zrem(self._INDEX, entity_id)
        return removed == 1

    async def count(self) -> int:
        return int(await self._r.zcard(self._INDEX))

    async def exists(self, entity_id: str) -> bool:
        return bool(await self._r.exists(self._key(entity_id)))


def get_repository() -> {{ crud_entity | capitalize }}Repository:
    return Redis{{ crud_entity | capitalize }}Repository()
