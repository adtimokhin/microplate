class Mongo{{ crud_entity | capitalize }}Repository:
    def __init__(self) -> None:
        from {{ python_package }}.db.mongodb import get_database

        self._col = get_database()["{{ crud_entity }}s"]

    def _to_entity(self, doc: dict[str, object]) -> Entity:
        return Entity(
            id=str(doc["_id"]),
            name=str(doc["name"]),
            description=str(doc.get("description", "")),
            created_at=doc["created_at"],
        )

    async def create(self, data: {{ crud_entity | capitalize }}Create) -> Entity:
        doc = {"_id": str(uuid.uuid4()), "created_at": _now(), **data.model_dump()}
        await self._col.insert_one(doc)
        return self._to_entity(doc)

    async def get(self, entity_id: str) -> Entity | None:
        doc = await self._col.find_one({"_id": entity_id})
        return self._to_entity(doc) if doc else None

    async def list(self, *, limit: int = 50, offset: int = 0) -> list[Entity]:
        cur = self._col.find().sort("created_at", 1).skip(offset).limit(limit)
        return [self._to_entity(d) async for d in cur]

    async def update(self, entity_id: str, data: {{ crud_entity | capitalize }}Update) -> Entity | None:
        patch = data.model_dump(exclude_none=True)
        if patch:
            await self._col.update_one({"_id": entity_id}, {"$set": patch})
        return await self.get(entity_id)

    async def delete(self, entity_id: str) -> bool:
        res = await self._col.delete_one({"_id": entity_id})
        return res.deleted_count == 1

    async def count(self) -> int:
        return await self._col.count_documents({})

    async def exists(self, entity_id: str) -> bool:
        return await self._col.find_one({"_id": entity_id}, {"_id": 1}) is not None


def get_repository() -> {{ crud_entity | capitalize }}Repository:
    return Mongo{{ crud_entity | capitalize }}Repository()
