"""Build the LangGraph checkpointer for the configured store.

{% if langgraph_checkpoint == 'postgres' %}Postgres: ``AsyncPostgresSaver`` over psycopg3 (a SEPARATE driver from the
``db_postgres`` asyncpg engine). Reuses ``APP_DB_POSTGRES_DSN``.
{% else %}Redis: ``AsyncRedisSaver``. Reuses ``APP_REDIS_URL``. Needs a redis-stack image
(RedisJSON + RediSearch) - the compose redis service is upgraded automatically
(image_resolution IR-1, D-015).
{% endif %}
Tests patch ``build_checkpointer`` to return an ``InMemorySaver`` (D-006).
"""

from __future__ import annotations

from typing import Any

from {{ python_package }}.config import get_settings

_cm: Any = None


async def build_checkpointer() -> Any:
{% if langgraph_checkpoint == 'postgres' %}    from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver

    dsn = get_settings().db_postgres_dsn.replace("+asyncpg", "")
    global _cm
    _cm = AsyncPostgresSaver.from_conn_string(dsn)
    saver = await _cm.__aenter__()
    await saver.setup()
    return saver
{% else %}    from langgraph.checkpoint.redis.aio import AsyncRedisSaver

    global _cm
    _cm = AsyncRedisSaver.from_conn_string(get_settings().redis_url)
    saver = await _cm.__aenter__()
    await saver.asetup()
    return saver
{% endif %}

async def close_checkpointer() -> None:
    global _cm
    if _cm is not None:
        await _cm.__aexit__(None, None, None)
        _cm = None
