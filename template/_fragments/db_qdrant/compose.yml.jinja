  qdrant:
    image: qdrant/qdrant:v1.19.1
    ports:
      - "6333:6333"
      - "6334:6334"
    healthcheck:
      # The qdrant image ships no curl/wget; it does ship bash. Probe /readyz
      # over a bash /dev/tcp socket instead.
      test:
        - CMD
        - bash
        - -c
        - 'exec 3<>/dev/tcp/127.0.0.1/6333; printf "GET /readyz HTTP/1.0\r\n\r\n" >&3; grep -q "200 OK" <&3'
      interval: 5s
      timeout: 3s
      retries: 15
      start_period: 10s
