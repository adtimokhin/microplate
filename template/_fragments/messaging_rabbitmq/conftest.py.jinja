class _RabbitmqFakeChannel:
    def __init__(self):
        self.exchanges = {}
        self.queues = {}
        self.prefetch_count = None
        self.closed = False

    async def set_qos(self, prefetch_count, *args, **kwargs):
        self.prefetch_count = prefetch_count

    async def declare_exchange(self, name, *args, **kwargs):
        return self.exchanges.setdefault(name, _RabbitmqFakeExchange(name))

    async def declare_queue(self, name, *args, **kwargs):
        return self.queues.setdefault(name, _RabbitmqFakeQueue(name))

    async def get_queue(self, name, *args, **kwargs):
        return self.queues.setdefault(name, _RabbitmqFakeQueue(name))

    async def close(self):
        self.closed = True


class _RabbitmqFakeRobustConnection:
    def __init__(self):
        self.channel_obj = _RabbitmqFakeChannel()
        self.is_closed = False

    async def channel(self, *args, **kwargs):
        return self.channel_obj

    async def close(self):
        self.is_closed = True


