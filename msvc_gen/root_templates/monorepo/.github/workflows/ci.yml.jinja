name: ci

on:
  push:
    branches: [main]
  pull_request:

jobs:
  services:
    strategy:
      fail-fast: false
      matrix:
        service:
{%- for svc in services %}
          - {{ svc.name }}
{%- endfor %}
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: services/{% raw %}${{ matrix.service }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          version: "0.12.10"
      - run: uv sync --locked
      - run: uv run ruff check .
      - run: uv run mypy
      - run: uv run pytest
{%- if tests_contract %}

  # gRPC contract guard for the shared proto/ tree (docs/grpc-contract-tests.md).
  # Default path: buf lint + buf breaking, buf pinned. If a team cannot add buf,
  # swap this job for the descriptor-set snapshot fallback (see the commented
  # block below and proto/gen_descriptor_set.py).
  proto-contract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: bufbuild/buf-setup-action@v1
        with:
          # Pinned. TODO(registry): source this from a registry.yaml tool pin.
          version: "1.47.2"
      - run: buf lint
      - run: buf breaking --against ".git#branch=main"

  # --- no-toolchain fallback (descriptor-set snapshot diff) ---
  # proto-contract-nobuff:
  #   runs-on: ubuntu-latest
  #   steps:
  #     - uses: actions/checkout@v4
  #     - uses: astral-sh/setup-uv@v5
  #       with: { version: "0.12.10" }
  #     - run: uv run --with grpcio-tools==1.83.1 python proto/gen_descriptor_set.py
  #     - run: git diff --exit-code proto/descriptor.pb
{%- endif %}
